{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/stoday/LLaDAR/blob/main/src/lladar/schemas/v3.json",
  "title": "LLaDAR external benchmark artifact contract version 3",
  "$defs": {
    "SourceLocator": {
      "type": "object", "properties": {
        "path": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1},
        "pointer": {"type": "string", "minLength": 1}
      }, "required": ["path", "line"], "additionalProperties": false
    },
    "Option": {
      "type": "object", "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string"}
      }, "required": ["id", "text"], "additionalProperties": false
    },
    "BenchmarkCase": {
      "type": "object", "properties": {
        "schema_version": {"const": 3},
        "id": {"type": "string", "minLength": 1},
        "status": {"enum": ["ready", "unsupported", "source_invalid"]},
        "kind": {"enum": ["single_choice", "multiple_choice", "ranking", "free_answer", "generation"]},
        "context": {"type": "string"},
        "prompt": {"type": "string", "minLength": 1},
        "options": {"type": "array", "items": {"$ref": "#/$defs/Option"}},
        "answer": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}, {"type": "null"}]},
        "rule_id": {"type": ["string", "null"]},
        "source": {"$ref": "#/$defs/SourceLocator"},
        "metadata": {"type": "object"},
        "reason_code": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }, "required": ["schema_version", "id", "status", "source"],
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"status": {"const": "ready"}}},
         "then": {"required": ["kind", "prompt", "options", "answer", "rule_id", "metadata"]}},
        {"if": {"properties": {"status": {"enum": ["unsupported", "source_invalid"]}}},
         "then": {"required": ["reason_code", "reason"]}}
      ]
    },
    "ScoringRule": {
      "type": "object", "properties": {
        "id": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "parameters": {"type": "object"},
        "scope": {"enum": ["case", "group"]},
        "metadata": {"type": "object"}
      }, "required": ["id", "method", "evidence"], "additionalProperties": false
    },
    "UnsupportedMetric": {
      "type": "object", "properties": {
        "id": {"type": "string", "minLength": 1},
        "reason_code": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1,
          "items": {"type": "string", "minLength": 1}}
      }, "required": ["id", "reason_code", "reason", "evidence"],
      "additionalProperties": false
    },    "BenchmarkScoringPlan": {
      "type": "object", "properties": {
        "schema_version": {"const": 3},
        "rules": {"type": "array", "items": {"$ref": "#/$defs/ScoringRule"}},
        "unsupported_metrics": {"type": "array", "items": {"$ref": "#/$defs/UnsupportedMetric"}},
        "converter": {"type": "string", "minLength": 1}
      }, "required": ["schema_version", "rules"], "additionalProperties": false
    },
    "ArtifactDescriptor": {
      "type": "object", "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }, "required": ["path", "sha256"], "additionalProperties": false
    },
    "BenchmarkManifest": {
      "type": "object", "properties": {
        "schema_version": {"const": 3},
        "source": {"type": "object"},
        "supplemental_documents": {"type": "array", "items": {"type": "object",
          "properties": {"url": {"type": "string"}, "path": {"type": "string"},
                         "sha256": {"type": "string"}},
          "required": ["url", "path", "sha256"], "additionalProperties": false}},
        "counts": {"type": "object"},
        "generation_protocol": {"type": "object", "properties": {
          "samples_per_case": {"type": "integer", "minimum": 1, "maximum": 20},
          "max_new_tokens": {"type": "integer", "minimum": 1},
          "stop_sequences": {"type": "array", "items": {"type": "string"}},
          "source_profiles": {"type": "array", "items": {"type": "object",
            "properties": {"model": {"type": "string", "minLength": 1},
                           "settings": {"type": "object", "minProperties": 1,
                             "additionalProperties": {"type": ["string", "number", "boolean"]}}},
            "required": ["model", "settings"], "additionalProperties": false}},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }, "required": ["evidence"], "additionalProperties": false},
        "artifacts": {"type": "object", "additionalProperties": {"$ref": "#/$defs/ArtifactDescriptor"}}
      }, "required": ["schema_version", "source", "counts", "artifacts"],
      "additionalProperties": false
    },
    "BenchmarkAnswer": {
      "type": "object", "properties": {
        "schema_version": {"const": 3},
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string"},
        "question": {"type": "string"},
        "sample_id": {"type": "string"},
        "status": {"enum": ["ok", "execution_error"]},
        "answer": {"type": "string"},
        "error": {"type": "string"}
      }, "required": ["schema_version", "id", "status"], "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"status": {"const": "ok"}}}, "then": {"required": ["answer"]}},
        {"if": {"properties": {"status": {"const": "execution_error"}}}, "then": {"required": ["error"]}}
      ]
    }
  }
}